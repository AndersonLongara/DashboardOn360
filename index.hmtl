    <div id="qrModal" class="modal-overlay" onclick="closeQRModalOnOverlay(event)">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Conectar WhatsApp</h3>
                <button class="modal-close" onclick="closeQRModal()">×</button>
            </div>
            <div class="qr-container" id="qrContainer">
                <div class="spinner"></div>
                <p>Gerando QR Code...</p>
            </div>
            <div class="qr-instructions">
                <strong>Como conectar:</strong><br>
                1. Abra o WhatsApp no seu celular<br>
                2. Toque em Menu ou Configurações<br>
                3. Toque em Aparelhos conectados<br>
                4. Toque em Conectar um aparelho<br>
                5. Aponte seu celular para esta tela
            </div>
        </div>
    </div>

    <script>
    const BASE_API = 'https://n8n.goobotchat.com.br/webhook/supabase';
    const EVOLUTION_API = 'https://wapi.goobotchat.com.br';
    const API_KEY = '';
    let chats = [], messagesHistory = [], providers = [], messages = [], links = [], logs = [], connections = [], productivityData = null, productivityChart = null, selectedChatInstance = null, selectedChatJid = null;
    let sortState = {column: null, direction: 'asc', table: null};
    let qrCheckInterval = null;
    let currentConnectionInstance = null;

    // --- CORE API UTILITIES ---

    async function apiRequest(endpoint, method = 'GET', data = null) {
        const opts = {
            method,
            mode: 'cors',
            headers: {
                'Content-Type': 'application/json',
                'X-Client': 'manager-ui',
                ...(API_KEY ? { 'X-API-KEY': API_KEY } : {})
            }
        };
        if (data) opts.body = JSON.stringify(data);
        const res = await fetch(`${BASE_API}${endpoint}`, opts);

        if (res.status === 404 || res.status === 204) {
            return null;
        }

        if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
        }
        
        try {
            return await res.json();
        } catch (error) {
            if (error instanceof SyntaxError) {
                return null;
            }
            throw error;
        }
    }

    async function evolutionRequest(endpoint, method = 'GET', apiToken, data = null) {
        const opts = {
            method,
            headers: {
                'Content-Type': 'application/json',
                'apikey': apiToken
            }
        };
        if (data) opts.body = JSON.stringify(data);
        const res = await fetch(`${EVOLUTION_API}${endpoint}`, opts);
        
        if (!res.ok) {
            const errorText = await res.text();
            throw new Error(`Evolution API error: ${res.status} - ${errorText}`);
        }
        
        return await res.json();
    }
    
    // --- GENERAL UI / APP HELPERS ---

    function toggleKebabMenu(event) {
        event.stopPropagation();
        const currentMenu = event.currentTarget.nextElementSibling;
        document.querySelectorAll('.kebab-menu-dropdown.show').forEach(menu => {
            if (menu !== currentMenu) {
                menu.classList.remove('show');
            }
        });
        currentMenu.classList.toggle('show');
    }

    function toggleTheme() {
        document.body.classList.toggle('dark-mode');
        const isDark = document.body.classList.contains('dark-mode');
        localStorage.setItem('darkMode', isDark ? 'enabled' : 'disabled');
        
        const lightIcon = document.querySelector('.theme-icon-light');
        const darkIcon = document.querySelector('.theme-icon-dark');
        
        if (isDark) {
            lightIcon.style.display = 'none';
            darkIcon.style.display = 'block';
        } else {
            lightIcon.style.display = 'block';
            darkIcon.style.display = 'none';
        }
        
        if (productivityChart) updateChartTheme();
    }

    function loadTheme() {
        const darkMode = localStorage.getItem('darkMode');
        if (darkMode === 'enabled') {
            document.body.classList.add('dark-mode');
            const lightIcon = document.querySelector('.theme-icon-light');
            const darkIcon = document.querySelector('.theme-icon-dark');
            if (lightIcon && darkIcon) {
                lightIcon.style.display = 'none';
                darkIcon.style.display = 'block';
            }
        }
    }

    function updateChartTheme() {
        const isDark = document.body.classList.contains('dark-mode');
        const textColor = isDark ? '#e9edef' : '#111b21';
        const gridColor = isDark ? '#2a3942' : '#e9edef';
        productivityChart.options.scales.y.ticks.color = textColor;
        productivityChart.options.scales.x.ticks.color = textColor;
        productivityChart.options.scales.y.grid.color = gridColor;
        productivityChart.options.scales.x.grid.color = gridColor;
        productivityChart.options.plugins.legend.labels.color = textColor;
        productivityChart.data.datasets[0].backgroundColor = [
            isDark ? 'rgba(0, 168, 132, 0.6)' : 'rgba(37, 211, 102, 0.6)',
            isDark ? 'rgba(0, 128, 105, 0.6)' : 'rgba(0, 168, 132, 0.6)',
            isDark ? 'rgba(40, 167, 69, 0.6)' : 'rgba(32, 186, 90, 0.6)'
        ];
        productivityChart.data.datasets[0].borderColor = [
            isDark ? 'rgba(0, 168, 132, 1)' : 'rgba(37, 211, 102, 1)',
            isDark ? 'rgba(0, 128, 105, 1)' : 'rgba(0, 168, 132, 1)',
            isDark ? 'rgba(40, 167, 69, 1)' : 'rgba(32, 186, 90, 1)'
        ];
        productivityChart.update();
    }

    async function showTab(tabName) {
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        
        const navItems = document.querySelectorAll('.nav-item');
        const tabNames = ['dashboard', 'chat', 'providers', 'messages', 'links', 'connections', 'logs'];
        const index = tabNames.indexOf(tabName);
        if (index !== -1 && navItems[index]) {
            navItems[index].classList.add('active');
        }
        
        document.getElementById(tabName).classList.add('active');
        
        const titles = {
            dashboard: ['Dashboard', 'Visão geral do sistema'],
            chat: ['Chats', 'Conversas recentes via WhatsApp'],
            providers: ['Prestadores', 'Gerenciar prestadores de serviço'],
            messages: ['Mensagens', 'Gerenciar templates de mensagens'],
            links: ['Vínculos', 'Gerenciar vínculos entre mensagens e prestadores'],
            connections: ['Conexões', 'Gerenciar conexões WhatsApp via Evolution API'],
            logs: ['Logs', 'Visualizar logs de execução']
        };

        const datePickerActions = document.getElementById('dashboard-date-pickers');

        if (titles[tabName]) {
            document.getElementById('pageTitle').textContent = titles[tabName][0];
            document.getElementById('pageSubtitle').textContent = titles[tabName][1];
        }

        // Mostra/esconde os seletores de data E carrega os dados da aba
        if (tabName === 'dashboard') {
            datePickerActions.style.display = 'flex';
            datePickerActions.style.flexDirection = 'row';
            datePickerActions.style.alignItems = 'center';
            datePickerActions.style.gap = '10px'; // Espaçamento entre label e input
            datePickerActions.style.justifyContent = 'flex-end';
            datePickerActions.style.flexWrap = 'nowrap';

            datePickerActions.querySelectorAll('.date-picker-label').forEach(label => {
                label.style.display = 'inline';
                label.style.width = 'auto';
                label.style.marginBottom = '0';
                label.style.padding = '0';
                label.style.whiteSpace = 'nowrap';
            });
            
            // 3. APLICA ESTILOS INLINE NOS FILHOS (INPUTS)
            datePickerActions.querySelectorAll('.date-picker-input').forEach(input => {
                input.style.display = 'inline-block';
                input.style.width = 'auto';
                input.style.flexGrow = '0';
                input.style.flexShrink = '0';
            });
            
            // 4. APLICA O ESPAÇAMENTO EXTRA ENTRE OS GRUPOS
            const labelAte = datePickerActions.querySelector('label[for="endDatePicker"]');
            if (labelAte) {
                // Adiciona o espaçamento entre o primeiro input e o label "Até:"
                labelAte.style.marginLeft = '10px'; 
            }

            await loadDashboardData();
        } else {
            datePickerActions.style.display = 'none'; // ESCONDE para todas as outras abas
        }

        if (tabName === 'chat') {
            await setupChatInstanceSelector(); // Preenche o seletor de instância
            await loadChats(); // Carrega os chats da instância selecionada
        }
        
        // Carrega dados das outras abas (conforme necessário)
        if (tabName === 'messages') await loadMessages();
        else if (tabName === 'links') {
            await loadProviders();
            await loadMessages();
            await loadLinks();
            loadLinkSelects();
        }
        else if (tabName === 'logs') await loadLogs();
        else if (tabName === 'providers') await loadProviders();
        else if (tabName === 'connections') await loadConnections();
        
        if (titles[tabName]) {
            document.getElementById('pageTitle').textContent = titles[tabName][0];
            document.getElementById('pageSubtitle').textContent = titles[tabName][1];
        }

        if (tabName === 'dashboard') await loadDashboardData();
        else if (tabName === 'messages') await loadMessages();
        else if (tabName === 'links') {
            await loadProviders();
            await loadMessages();
            await loadLinks();
            loadLinkSelects();
        }
        else if (tabName === 'logs') await loadLogs();
        else if (tabName === 'providers') await loadProviders();
        else if (tabName === 'connections') await loadConnections();
    }

    function showAlert(elementId, message, type) {
        const alertDiv = document.getElementById(elementId);
        alertDiv.innerHTML = `<div class="alert alert-${type}">${message}</div>`;
        setTimeout(() => alertDiv.innerHTML = '', 4000);
    }

    // --- TABLE SORTING HELPERS ---

    

    function parseBrazilianDateTime(dateTimeString) {
        if (!dateTimeString || typeof dateTimeString !== 'string') {
            return null;
        }
        // Separa data e hora: ["11/10/2025", "10:16:16"]
        const parts = dateTimeString.split(', ');
        if (parts.length !== 2) return null;

        // Separa dia, mês, ano: ["11", "10", "2025"]
        const dateParts = parts[0].split('/');
        if (dateParts.length !== 3) return null;

        // Separa hora, minuto, segundo: ["10", "16", "16"]
        const timeParts = parts[1].split(':');
        if (timeParts.length !== 3) return null;

        const day = parseInt(dateParts[0], 10);
        const month = parseInt(dateParts[1], 10) - 1; // Mês é 0-indexado em JS!
        const year = parseInt(dateParts[2], 10);
        const hour = parseInt(timeParts[0], 10);
        const minute = parseInt(timeParts[1], 10);
        const second = parseInt(timeParts[2], 10);

        // Verifica se os números são válidos antes de criar a data
        if (isNaN(day) || isNaN(month) || isNaN(year) || isNaN(hour) || isNaN(minute) || isNaN(second)) {
            return null;
        }

        return new Date(year, month, day, hour, minute, second);
    }

    function sortTable(tableId, column) {
        const table = document.getElementById(tableId);
        const tbody = table.querySelector('tbody');
        if (!tbody) return; // Adiciona verificação
        const rows = Array.from(tbody.querySelectorAll('tr'));
        
        // Remove classes de ordenação dos cabeçalhos
        table.querySelectorAll('th').forEach(th => th.classList.remove('sort-asc', 'sort-desc'));
        
        // Determina a direção da ordenação
        if (sortState.table === tableId && sortState.column === column) {
            sortState.direction = sortState.direction === 'asc' ? 'desc' : 'asc';
        } else {
            sortState.table = tableId;
            sortState.column = column;
            sortState.direction = 'asc';
        }
        
        // Adiciona classe de ordenação ao cabeçalho ativo
        const activeHeader = table.querySelector(`th[data-column="${column}"]`);
        if (activeHeader) activeHeader.classList.add(sortState.direction === 'asc' ? 'sort-asc' : 'sort-desc');
        
        // Ordena as linhas
        const sortedRows = rows.sort((a, b) => {
            const aValue = getCellValue(a, column);
            const bValue = getCellValue(b, column);

            // --- LÓGICA DE ORDENAÇÃO DE DATA ATUALIZADA ---
            if (column === 'created_at' || column === 'started_at') {
                // Usa a nova função para parsear as datas
                const aDate = parseBrazilianDateTime(aValue);
                const bDate = parseBrazilianDateTime(bValue);

                // Se alguma data for inválida, trata como "menor" para evitar erros
                if (!aDate && !bDate) return 0;
                if (!aDate) return sortState.direction === 'asc' ? -1 : 1;
                if (!bDate) return sortState.direction === 'asc' ? 1 : -1;

                // Compara os objetos Date (comparação numérica correta)
                return sortState.direction === 'asc' ? aDate - bDate : bDate - aDate;
            } 
            // --- FIM DA ATUALIZAÇÃO ---

            // Lógica para duração (trata como número)
            if (column === 'duration_ms') { 
                // Remove o 's' e converte para número
                const aNum = parseFloat(aValue.replace('s', '')) || 0;
                const bNum = parseFloat(bValue.replace('s', '')) || 0;
                return sortState.direction === 'asc' ? aNum - bNum : bNum - aNum;
            }

            // Lógica padrão para outras colunas (comparação de strings)
            // Usa localeCompare para ordenação alfabética correta (acentos, etc.)
            return sortState.direction === 'asc' 
                   ? aValue.localeCompare(bValue, 'pt-BR', { sensitivity: 'base' }) 
                   : bValue.localeCompare(aValue, 'pt-BR', { sensitivity: 'base' });
        });
        
        // Limpa e reapenda as linhas ordenadas
        tbody.innerHTML = ''; 
        sortedRows.forEach(row => tbody.appendChild(row));
    }

    function setupTableSorting(tableId) {
        const table = document.getElementById(tableId);
        if (!table) return;
        table.querySelectorAll('th.sortable').forEach(h => {
            // Remove listener antigo ANTES de adicionar o novo
            // Cria uma função nomeada para poder remover depois
            const clickHandler = () => sortTable(tableId, h.dataset.column);
            // Guarda a referência para poder remover
            if (h._sortClickHandler) {
                 h.removeEventListener('click', h._sortClickHandler);
            }
            h._sortClickHandler = clickHandler; // Armazena a nova referência
            h.addEventListener('click', h._sortClickHandler);
        });
    }

    function getCellValue(row, column) {
        const cellIndex = Array.from(row.parentElement.parentElement.querySelectorAll('th')).findIndex(th => th.dataset.column === column);
        if (cellIndex === -1) return '';
        const cell = row.cells[cellIndex];
        if (!cell) return '';
        const badge = cell.querySelector('.badge');
        if (badge) return badge.textContent.trim();
        return cell.textContent.trim();
    }

    // --- DASHBOARD LOGIC ---

    async function loadDashboardData() {
        try {
            document.getElementById('dashboardLoading').style.display = 'block';
            document.getElementById('dashboardContent').style.display = 'none';

            const startDate = document.getElementById('startDatePicker').value;
            const endDate = document.getElementById('endDatePicker').value;

            if (!startDate || !endDate) {
                document.getElementById('dashboardLoading').style.display = 'none';
                document.getElementById('dashboardContent').style.display = 'block';
                return;
            }

            const dateParams = `?startDate=${startDate}&endDate=${endDate}`;
            const apiResponse = await apiRequest(`/produtividade${dateParams}`);
            
            const dataAsArray = apiResponse && apiResponse.data ? apiResponse.data : [];

            let dataForChart;

            if (dataAsArray.length === 0) {
                dataForChart = {
                    execucoes: 0,
                    minutos_economizados: 0,
                    custo_economizado: 0.00,
                    dia: `${startDate} a ${endDate}`
                };
            } else {
                const totals = dataAsArray.reduce((accumulator, currentDay) => {
                    accumulator.execucoes += parseFloat(currentDay.execucoes || 0);
                    accumulator.minutos_economizados += parseFloat(currentDay.minutos_economizados || 0);
                    accumulator.custo_economizado += parseFloat(currentDay.custo_economizado || 0);
                    return accumulator;
                }, { execucoes: 0, minutos_economizados: 0, custo_economizado: 0.00 });

                dataForChart = {
                    ...totals,
                    dia: `${startDate} a ${endDate}`
                };
            }
            
            productivityData = dataForChart;
            renderDashboard();

            document.getElementById('dashboardLoading').style.display = 'none';
            document.getElementById('dashboardContent').style.display = 'block';

        } catch (error) {
            console.error('Erro ao carregar dashboard:', error);
            document.getElementById('dashboardLoading').innerHTML = '<p style="color:#dc3545;">❌ Erro ao carregar dashboard.</p>';
        }
    }

    function renderDashboard() {
        if (!productivityData) return;
        document.getElementById('cardExecucoes').textContent = productivityData.execucoes || 0;
        document.getElementById('cardMinutos').textContent = productivityData.minutos_economizados || 0;
        document.getElementById('cardCusto').textContent = (productivityData.custo_economizado || 0).toFixed(2).replace('.', ',');
        const ctx = document.getElementById('productivityChart').getContext('2d');
        if (productivityChart) productivityChart.destroy();
        const isDark = document.body.classList.contains('dark-mode');
        const textColor = isDark ? '#e9edef' : '#111b21';
        const gridColor = isDark ? '#2a3942' : '#e9edef';
        productivityChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Execuções', 'Minutos Economizados', 'Custo (R$)'],
                datasets: [{
                    label: `Produtividade (${productivityData.dia || ''})`,
                    data: [productivityData.execucoes || 0, productivityData.minutos_economizados || 0, productivityData.custo_economizado || 0],
                    backgroundColor: [
                        isDark ? 'rgba(0, 168, 132, 0.6)' : 'rgba(37, 211, 102, 0.6)',
                        isDark ? 'rgba(0, 128, 105, 0.6)' : 'rgba(0, 168, 132, 0.6)',
                        isDark ? 'rgba(40, 167, 69, 0.6)' : 'rgba(32, 186, 90, 0.6)'
                    ],
                    borderColor: [
                        isDark ? 'rgba(0, 168, 132, 1)' : 'rgba(37, 211, 102, 1)',
                        isDark ? 'rgba(0, 128, 105, 1)' : 'rgba(0, 168, 132, 1)',
                        isDark ? 'rgba(40, 167, 69, 1)' : 'rgba(32, 186, 90, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { color: textColor }, grid: { color: gridColor } },
                    x: { ticks: { color: textColor }, grid: { color: gridColor } }
                },
                responsive: true,
                plugins: { legend: { labels: { color: textColor } } }
            }
        });
    }
    // --- CHAT LOGIC ---

    async function setupChatInstanceSelector() {
        const selector = document.getElementById('chatInstanceSelector');
        selector.innerHTML = ''; // Limpa opções anteriores

        // Garante que as conexões estejam carregadas (pode otimizar se já carregou antes)
        if (!connections || connections.length === 0) {
            await loadConnections(); 
        }

        if (connections && connections.length > 0) {
            connections.forEach(conn => {
                // Adiciona apenas instâncias conectadas (status 'open')
                if (conn.currentStatus === 'open') {
                    const option = document.createElement('option');
                    option.value = conn.id; // Usar o ID da conexão como valor
                    option.textContent = conn.name;
                    selector.appendChild(option);
                }
            });
            selector.style.display = 'inline-block'; // Mostra o seletor

            // Define a instância selecionada inicial (se houver alguma conectada)
            if (selector.options.length > 0) {
                 if (!selectedChatInstance) { // Seleciona a primeira apenas na primeira vez
                     selector.selectedIndex = 0;
                     selectedChatInstance = connections.find(c => c.id === selector.value);
                 } else {
                     // Mantém a seleção anterior se possível
                     selector.value = selectedChatInstance.id;
                 }
            } else {
                 selectedChatInstance = null; // Nenhuma instância conectada
                 showAlert('chatAlert', 'Nenhuma conexão ativa encontrada para carregar chats.', 'warning');
            }

        } else {
            selector.style.display = 'none'; // Esconde se não houver conexões
            selectedChatInstance = null;
            showAlert('chatAlert', 'Cadastre e conecte uma instância primeiro.', 'warning');
        }
    }

    /**
     * Carrega a lista de chats da API da Evolution para a instância selecionada.
     */
    async function loadChats() {
        // Atualiza a instância selecionada com base no dropdown
        const selector = document.getElementById('chatInstanceSelector');
        selectedChatInstance = connections.find(c => c.id === selector.value);

        const chatListContainer = document.getElementById('chatListContainer');
        const loadingIndicator = document.getElementById('chatLoading');
        chatListContainer.innerHTML = ''; // Limpa a lista
        
        if (!selectedChatInstance) {
            showAlert('chatAlert', 'Selecione uma instância conectada.', 'warning');
            loadingIndicator.style.display = 'none';
            chatListContainer.innerHTML = '<p style="text-align: center; padding: 20px; color: var(--text-secondary);">Selecione uma instância ativa.</p>';
            return;
        }

        loadingIndicator.style.display = 'block'; // Mostra o loading
        showAlert('chatAlert', '', ''); // Limpa alertas anteriores

        try {
            // Usa evolutionRequest que já temos, passando nome e token corretos
            const chatData = await evolutionRequest(
                `/chat/findChats/${selectedChatInstance.name}`,
                'POST', // A API pede POST para esta rota
                selectedChatInstance.api_key
            );

            chats = Array.isArray(chatData) ? chatData : [];
            renderChats(chats);

        } catch (error) {
            console.error('Erro ao carregar chats:', error);
            showAlert('chatAlert', `Erro ao carregar chats: ${error.message}`, 'error');
            chatListContainer.innerHTML = '<p style="text-align: center; padding: 20px; color: #dc3545;">❌ Falha ao carregar conversas.</p>';
        } finally {
            loadingIndicator.style.display = 'none'; // Esconde o loading
        }
    }

    function formatMessageTimestamp(unixTimestamp) {
        if (!unixTimestamp) return '';
        const messageDate = new Date(unixTimestamp * 1000);
        return messageDate.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    }

    function renderChats(chatList) {
        const container = document.getElementById('chatListContainer');
        container.innerHTML = ''; 

        if (!chatList || chatList.length === 0) {
            container.innerHTML = '<p style="text-align: center; padding: 40px; color: var(--text-secondary);">Nenhuma conversa recente encontrada.</p>';
            return;
        }

        chatList.sort((a, b) => (b.lastMessage?.messageTimestamp || 0) - (a.lastMessage?.messageTimestamp || 0));

        chatList.forEach(chat => {
            const chatItem = document.createElement('div');
            chatItem.className = 'chat-list-item';
            chatItem.dataset.remoteJid = chat.remoteJid;

            // --- ATUALIZAÇÃO: Adiciona classe 'active' se for o chat selecionado ---
            if (chat.remoteJid === selectedChatJid) {
                chatItem.classList.add('active');
            }
            // --- FIM DA ATUALIZAÇÃO ---

           
            // --- ATUALIZAÇÃO: Adiciona onclick ---
            chatItem.onclick = () => openChatWindow(chat.remoteJid, displayName, chat.profilePicUrl);
            // --- FIM DA ATUALIZAÇÃO ---


            // Avatar
            const avatarDiv = document.createElement('div');
            avatarDiv.className = 'chat-avatar'; 
            if (chat.profilePicUrl) {
                const img = document.createElement('img');
                img.src = chat.profilePicUrl;
                img.alt = ''; 
                img.onerror = () => { 
                    avatarDiv.innerHTML = `<span class="material-symbols-outlined">account_circle</span>`; 
                };
                avatarDiv.appendChild(img);
            } else {
                avatarDiv.innerHTML = `<span class="material-symbols-outlined">account_circle</span>`;
            }      

            // --- Informações ---
            const infoDiv = document.createElement('div');
            infoDiv.className = 'chat-info'; 

            // ... (código do infoDiv, infoHeader, name, timestamp como antes) ...
            // Info Header
            const infoHeader = document.createElement('div'); /*...*/
            infoHeader.className = 'chat-info-header';

            const name = document.createElement('span'); /*...*/
            name.className = 'chat-name';
            let displayName = chat.pushName || chat.lastMessage?.pushName || formatJid(chat.remoteJid) || 'Desconhecido';
            if (displayName === 'Você' && chat.lastMessage?.key?.fromMe) {
                displayName = formatJid(chat.remoteJid) || 'Desconhecido'; 
            }
            name.textContent = displayName;
            name.title = displayName;
            
            const timestamp = document.createElement('span');
            timestamp.className = 'chat-timestamp';
            timestamp.textContent = chat.lastMessage?.messageTimestamp
                ? formatTimestamp(chat.lastMessage.messageTimestamp)
                : ''; 

            infoHeader.appendChild(name);
            infoHeader.appendChild(timestamp);

            /// Snippet Details
            const snippetDetails = document.createElement('div');
            snippetDetails.className = 'chat-snippet-details';

            const snippet = document.createElement('span');
            snippet.className = 'chat-snippet';
            snippet.innerHTML = formatSnippet(chat.lastMessage); 

            snippetDetails.appendChild(snippet);

            if (chat.unreadCount > 0) {
            const unreadBadge = document.createElement('span');
            unreadBadge.className = 'chat-unread-badge';
            unreadBadge.textContent = chat.unreadCount;
            snippetDetails.appendChild(unreadBadge);
        }


            // MONTAGEM CORRETA DA ESTRUTURA
            infoDiv.appendChild(infoHeader);
            infoDiv.appendChild(snippetDetails);
            
            chatItem.appendChild(avatarDiv);
            chatItem.appendChild(infoDiv);
            
            container.appendChild(chatItem);
        });
    }

    async function openChatWindow(remoteJid, chatName, profilePicUrl) {
        console.log(`Abrindo chat para: ${remoteJid}`);
        selectedChatJid = remoteJid;

        // Atualiza a lista da esquerda para marcar o item ativo
        document.querySelectorAll('#chatListContainer .chat-list-item').forEach(item => {
            if (item.dataset.remoteJid === remoteJid) {
                item.classList.add('active');
            } else {
                item.classList.remove('active');
            }
        });

        // Atualiza o header da coluna da direita
        document.getElementById('messageViewName').textContent = chatName;
        const avatarHeader = document.getElementById('messageViewAvatar');
        if (profilePicUrl) {
            avatarHeader.innerHTML = `<img src="${profilePicUrl}" alt="">`;
            avatarHeader.querySelector('img').onerror = () => { 
                avatarHeader.innerHTML = `<span class="material-symbols-outlined">account_circle</span>`; 
            };
        } else {
            avatarHeader.innerHTML = `<span class="material-symbols-outlined">account_circle</span>`;
        }

        // Limpa mensagens antigas e mostra loading
        const messageList = document.getElementById('messageList');
        messageList.innerHTML = `<div class="loading"><div class="spinner"></div><p>Carregando mensagens...</p></div>`;

        if (!selectedChatInstance) {
            showAlert('chatAlert', 'Instância não selecionada ou desconectada.', 'error');
            messageList.innerHTML = '<p class="message-list-placeholder">Erro ao carregar.</p>';
            return;
        }

        try {
            const messagesData = await evolutionRequest(
                `/chat/findMessages/${selectedChatInstance.name}`,
                'POST',
                selectedChatInstance.api_key,
                {
                    where: {
                        key: {
                            remoteJid: remoteJid
                        }
                    }
                }
            );

            console.log('Dados recebidos da API:', messagesData); // Debug

            // CORREÇÃO: Garante que seja sempre um array
            let messages = [];
            
            if (Array.isArray(messagesData)) {
                messages = messagesData;
            } else if (messagesData && Array.isArray(messagesData.messages)) {
                messages = messagesData.messages;
            } else if (messagesData && typeof messagesData === 'object') {
                // Se for um objeto único, transforma em array
                messages = [messagesData];
            }
            
            // Filtra mensagens inválidas
            messagesHistory = messages.filter(msg => msg && msg.messageTimestamp);
            
            // Ordena por timestamp (mais antigas primeiro)
            if (messagesHistory.length > 0) {
                messagesHistory.sort((a, b) => (a.messageTimestamp || 0) - (b.messageTimestamp || 0));
            }
            
            console.log('Mensagens processadas:', messagesHistory.length); // Debug
            
            renderChatMessages(messagesHistory);

        } catch (error) {
            console.error(`Erro ao buscar mensagens para ${remoteJid}:`, error);
            showAlert('chatAlert', `Erro ao buscar mensagens: ${error.message}`, 'error');
            messageList.innerHTML = `
                <div class="message-list-placeholder" style="color: var(--text-secondary); padding: 40px; text-align: center;">
                    <span class="material-symbols-outlined" style="font-size: 48px; display: block; margin-bottom: 10px;">error</span>
                    <p>❌ Falha ao carregar histórico.</p>
                    <small style="display: block; margin-top: 10px; opacity: 0.7;">Erro: ${error.message}</small>
                </div>
            `;
        }
    }

    function renderChatMessages(messages) {
        const messageList = document.getElementById('messageList');
        messageList.innerHTML = ''; // Limpa o loading ou mensagens anteriores

        if (!messages || messages.length === 0) {
            messageList.innerHTML = '<p class="message-list-placeholder" style="padding: 40px;">Nenhuma mensagem nesta conversa.</p>';
            return;
        }

        messages.forEach(msg => {
            const bubble = document.createElement('div');
            bubble.classList.add('message-bubble');

            const isSent = msg.key?.fromMe === true;
            bubble.classList.add(isSent ? 'sent' : 'received');

            const content = document.createElement('div');
            content.className = 'message-content';
            // Formatar conteúdo baseado no msg.messageType (similar ao formatSnippet, mas completo)
            // Por simplicidade, vamos mostrar apenas texto por enquanto
            if (msg.messageType === 'conversation' && msg.message?.conversation) {
                 content.textContent = msg.message.conversation;
            } else if (msg.messageType === 'imageMessage' && msg.message?.imageMessage) {
                 content.innerHTML = `📷 Imagem ${msg.message.imageMessage.caption ? '<br><em>' + msg.message.imageMessage.caption + '</em>' : ''}`;
                 // Idealmente, carregar a imagem aqui
            } else if (msg.messageType === 'audioMessage') {
                content.innerHTML = `🎤 Áudio`;
                // Idealmente, adicionar um player aqui
            } else {
                content.textContent = `[${msg.messageType || 'Tipo não suportado'}]`; // Fallback
            }


            const timestamp = document.createElement('span');
            timestamp.className = 'message-timestamp';
            timestamp.textContent = formatMessageTimestamp(msg.messageTimestamp); // Usa HH:MM

            bubble.appendChild(content);
            bubble.appendChild(timestamp);
            messageList.appendChild(bubble);
        });

        // Scroll para a mensagem mais recente (final da lista)
        messageList.scrollTop = messageList.scrollHeight;
    }

    // --- Funções Auxiliares para Formatação ---

    /**
     * Formata um JID (ex: 555199... @s.whatsapp.net) para exibição.
     * Remove o @s.whatsapp.net ou @lid
     * @param {string} jid
     * @returns {string} - JID formatado ou o original se não reconhecido.
     */
    function formatJid(jid) {
        if (!jid) return '';
        return jid.split('@')[0];
    }

    /**
     * Formata um timestamp Unix (segundos) para exibição relativa (Hoje, Ontem, DD/MM).
     * @param {number} unixTimestamp - Timestamp em segundos.
     * @returns {string} - Data/hora formatada.
     */
    function formatTimestamp(unixTimestamp) {
        if (!unixTimestamp) return '';
        const messageDate = new Date(unixTimestamp * 1000); // Converte para milissegundos
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const yesterday = new Date(today);
        yesterday.setDate(today.getDate() - 1);

        if (messageDate >= today) {
            // Hoje: Retorna HH:MM
            return messageDate.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        } else if (messageDate >= yesterday) {
            // Ontem
            return 'Ontem';
        } else {
            // Mais antigo: Retorna DD/MM/YY
            return messageDate.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: '2-digit'});
        }
    }

    /**
     * Gera um snippet de preview da última mensagem.
     * @param {object} lastMessage - Objeto lastMessage da API.
     * @returns {string} - Snippet formatado (HTML).
     */
    /**
     * Gera um snippet de preview da última mensagem com ícones e prefixo "Você:".
     * @param {object} lastMessage - Objeto lastMessage da API.
     * @returns {string} - Snippet formatado (HTML).
     */
    function formatSnippet(lastMessage) {
        if (!lastMessage) return '<span style="font-style: italic;">Sem mensagens</span>'; // Mensagem padrão

        let prefix = lastMessage.key?.fromMe ? '<span class="sender-prefix">Você: </span>' : '';
        let icon = '';
        let content = '';

        // Mapeamento de messageType para ícones Material Symbols
        const iconMap = {
            imageMessage: 'photo_camera',
            videoMessage: 'videocam',
            audioMessage: 'mic',
            documentMessage: 'description',
            locationMessage: 'location_on',
            contactMessage: 'person',
            stickerMessage: 'mood', // Exemplo para sticker
            // Adicione outros tipos se necessário
        };

        const typeIcon = iconMap[lastMessage.messageType];
        if (typeIcon) {
            // Usa span com a classe do Material Symbols
            icon = `<span class="material-symbols-outlined">${typeIcon}</span>`;
        }

        switch (lastMessage.messageType) {
            case 'conversation':
                content = lastMessage.message?.conversation || '';
                break;
            case 'imageMessage':
                content = lastMessage.message?.imageMessage?.caption || 'Imagem'; // Usa caption se houver
                break;
            case 'videoMessage':
                 content = lastMessage.message?.videoMessage?.caption || 'Vídeo'; // Usa caption se houver
                 break;
            case 'audioMessage':
                content = 'Áudio'; // WhatsApp geralmente não mostra duração aqui
                break;
            case 'documentMessage':
                 content = lastMessage.message?.documentMessage?.fileName || 'Documento'; // Usa nome do arquivo se houver
                 break;
            case 'templateMessage':
                 // Pega o texto principal do template
                 let templateText = lastMessage.message?.templateMessage?.hydratedTemplate?.hydratedContentText || 
                                   lastMessage.message?.templateMessage?.hydratedFourRowTemplate?.hydratedContentText ||
                                   '[Mensagem de Modelo]';
                 content = templateText.split('\n')[0]; // Pega só a primeira linha se for longo
                 break;
            // Adicione mais casos...
            default:
                content = `[${lastMessage.messageType || 'Mensagem'}]`;
        }
        
        // Sanitização básica
        content = content.replace(/</g, "&lt;").replace(/>/g, "&gt;");

        // Truncamento (considerando ícone e prefixo)
        const maxTotalLength = 45; // Ajuste conforme necessário
        const currentLength = (prefix ? 6 : 0) + (icon ? 2 : 0) + content.length;
        if (currentLength > maxTotalLength) {
             const availableLength = maxTotalLength - (prefix ? 6 : 0) - (icon ? 2 : 0);
             content = content.substring(0, Math.max(0, availableLength - 3)) + '...';
        }

        // Junta tudo: Ícone (se houver) + Prefixo (se houver) + Conteúdo
        return `${icon}${prefix}${content}`;
    }

    // --- PROVIDERS LOGIC ---

    async function loadProviders() {
        try {
            document.getElementById('providersLoading').style.display = 'block';
            document.getElementById('providersTable').style.display = 'none';
            const data = await apiRequest('/providers-list');
            providers = Array.isArray(data) ? data : (data?.providers ?? []);
            renderProviders();
            document.getElementById('providersLoading').style.display = 'none';
            document.getElementById('providersTable').style.display = 'table';
        } catch (error) {
            console.error('Erro ao carregar prestadores:', error);
            document.getElementById('providersLoading').innerHTML = '<p style="color:#dc3545;">❌ Erro ao carregar prestadores.</p>';
        }
    }

    async function saveProvider(e) {
        e.preventDefault();
        const btn = document.getElementById('saveProviderBtn');
        btn.disabled = true;
        btn.innerHTML = '<svg viewBox="0 0 24 24" style="width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> Salvando...';
        try {
            const id = document.getElementById('providerId').value;
            const payload = {
                full_name: document.getElementById('providerFullName').value,
                envia_mesange_cliente: document.getElementById('providerEnviaCliente').checked,
                envia_mensagem_prestador: document.getElementById('providerEnviaPrestador').checked
