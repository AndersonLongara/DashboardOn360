    // --- CONNECTIONS LOGIC ---

    async function loadConnections() {
        try {
            document.getElementById('connectionsLoading').style.display = 'block';
            document.getElementById('connectionsTable').style.display = 'none';
            const data = await apiRequest('/connections-list');
            connections = Array.isArray(data) ? data : (data?.connections ?? []);
            
            const updatePromises = connections.map(conn => updateConnectionStatus(conn));
            
            // 3. Espera TODAS as chamadas terminarem
            await Promise.all(updatePromises);
            
            renderConnections();
            document.getElementById('connectionsLoading').style.display = 'none';
            document.getElementById('connectionsTable').style.display = 'table';
        } catch (error) {
            console.error('Erro ao carregar conexões:', error);
            document.getElementById('connectionsLoading').innerHTML = '<p style="color:#dc3545;">❌ Erro ao carregar conexões.</p>';
        }
    }

    async function updateConnectionStatus(connection) {
        let status = 'close';
        let phone = '-';
        let created = '-'

        try {
            const statusResponse = await fetch(`${EVOLUTION_API}/instance/connectionState/${connection.name}`, {
                headers: { 'apikey': connection.api_key }
            });

            if (statusResponse.ok) {
                const statusData = await statusResponse.json();
                status = statusData.instance?.state || 'close'; 
            } else {
                status = 'error';
            }
            
            if (status === 'open') {
                try {
                    const infoResponse = await fetch(`${EVOLUTION_API}/instance/fetchInstances`, {
                        headers: { 'apikey': connection.api_key }
                    });
                    if (infoResponse.ok) {
                        const infoData = await infoResponse.json();
                        if (infoData && infoData.length > 0) {
                            // O número está em "instance.owner"
                            phone = infoData[0].ownerJid || '-';
                            created = infoData[0].createdAt || '-';
                        }
                    }
                } catch (e) {
                    phone = '-'; 
                    console.error('Erro ao buscar detalhes da instância:', e);
                }
            }

        } catch (error) {
            console.error('Erro ao verificar status:', error);
            status = 'error';
        }

        connection.currentStatus = status;
        connection.phoneNumber = phone;
        connection.createdAt = created;
    }
    
    async function saveConnection(e) {
        e.preventDefault();
        const btn = document.getElementById('saveConnectionBtn');
        btn.disabled = true;
        btn.innerHTML = '<svg viewBox="0 0 24 24" style="width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> Verificando...';
        
        try {
            const instanceName = document.getElementById('instanceName').value;
            const apiToken = document.getElementById('apiToken').value;
            
            const checkResponse = await fetch(`${EVOLUTION_API}/instance/connectionState/${instanceName}`, {
                headers: { 'apikey': apiToken }
            });
            
            if (!checkResponse.ok) {
                throw new Error('Instância não encontrada ou token inválido');
            }
            
            const id = document.getElementById('connectionId').value;
            const payload = {
                instance_name: instanceName,
                api_token: apiToken
            };
            
            if (id) {
                await apiRequest('/connections-update', 'POST', { id, ...payload });
                showAlert('connectionAlert', 'Conexão atualizada!', 'success');
            } else {
                await apiRequest('/connections-create', 'POST', payload);
                showAlert('connectionAlert', 'Conexão criada com sucesso!', 'success');
            }
            
            clearConnectionForm();
            await loadConnections();
        } catch (error) {
            showAlert('connectionAlert', 'Erro: ' + error.message, 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<svg viewBox="0 0 24 24" style="width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2;"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg> Salvar Conexão';
        }
    }

    function clearConnectionForm() {
        document.getElementById('connectionForm').reset();
        document.getElementById('connectionId').value = '';
    }

    function editConnection(id) {
        const conn = connections.find(c => c.id === id);
        if (!conn) return;
        document.getElementById('connectionId').value = conn.id;
        document.getElementById('instanceName').value = conn.name ?? '';
        document.getElementById('apiToken').value = conn.api_token ?? '';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function deleteConnection(id) {
        if (!confirm('Excluir esta conexão?')) return;
        try {
            await apiRequest('/connections-delete', 'POST', { id });
            showAlert('connectionAlert', 'Conexão excluída!', 'success');
            await loadConnections();
        } catch (error) {
            showAlert('connectionAlert', 'Erro: ' + error.message, 'error');
        }
    }

    async function connectInstance(id) {
        const conn = connections.find(c => c.id === id);
        if (!conn) return;
        
        try {
            currentConnectionInstance = conn;
            
            const qrResponse = await evolutionRequest('/instance/connect/' + conn.name, 'GET', conn.api_key);
            
            if (qrResponse.base64 || qrResponse.code) {
                const qrCode = qrResponse.base64 || qrResponse.code;
                showQRModal(qrCode, conn);
            } else {
                showAlert('connectionAlert', 'Não foi possível gerar o QR Code', 'error');
            }
        } catch (error) {
            showAlert('connectionAlert', 'Erro ao conectar: ' + error.message, 'error');
        }
    }

    async function disconnectInstance(id) {
        if (!confirm('Deseja desconectar esta instância?')) return;
        
        const conn = connections.find(c => c.id === id);
        if (!conn) return;
        
        try {
            await evolutionRequest('/instance/logout/' + conn.name, 'DELETE', conn.api_key);
            showAlert('connectionAlert', 'Instância desconectada!', 'success');
            await loadConnections();
        } catch (error) {
            showAlert('connectionAlert', 'Erro ao desconectar: ' + error.message, 'error');
        }
    }

    async function restartInstance(id) {
        if (!confirm('Deseja reiniciar esta instância?')) return;
        
        const conn = connections.find(c => c.id === id);
        if (!conn) return;
        
        try {
            await evolutionRequest('/instance/restart/' + conn.name, 'PUT', conn.api_key);
            showAlert('connectionAlert', 'Instância reiniciada!', 'success');
            setTimeout(() => loadConnections(), 2000);
        } catch (error) {
            showAlert('connectionAlert', 'Erro ao reiniciar: ' + error.message, 'error');
        }
    }

    function renderConnections() {
        const tbody = document.querySelector('#connectionsTable tbody');
        tbody.innerHTML = '';
        if (!connections.length) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:20px;">Nenhuma conexão cadastrada</td></tr>';
            return;
        }
        
        connections.forEach(conn => {
            const statusMap = {
                'open': '<span class="badge badge-connected">Conectado</span>',
                'close': '<span class="badge badge-disconnected">Desconectado</span>',
                'connecting': '<span class="badge badge-connecting">Conectando</span>',
                'error': '<span class="badge badge-error">Erro</span>'
            };
            
            const statusBadge = statusMap[conn.currentStatus] || '<span class="badge badge-inactive">Desconhecido</span>';
            const phoneNumber = conn.phoneNumber || '-';
            const isConnected = conn.currentStatus === 'open';
            
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${conn.name ?? ''}</strong></td>
                <td>${statusBadge}</td>
                <td>${phoneNumber}</td>
                <td>${conn.createdAt? new Date(conn.createdAt).toLocaleString('pt-BR') : '-'}</td>
                <td class="actions">
                    <div class="desktop-actions">
                        ${!isConnected ? `<button class="btn btn-success" onclick="connectInstance('${conn.id}')"><span class="material-symbols-outlined">qr_code_2</span> Conectar</button>` : ''}
                        ${isConnected ? `<button class="btn btn-danger" onclick="disconnectInstance('${conn.id}')"><span class="material-symbols-outlined">link_off</span> Desconectar</button>` : ''}
                        <button class="btn btn-warning" onclick="restartInstance('${conn.id}')"><span class="material-symbols-outlined">restart_alt</span> Reiniciar</button>
                        <button class="btn btn-primary" onclick="editConnection('${conn.id}')"><span class="material-symbols-outlined">edit</span> Editar</button>
                        <button class="btn btn-danger" onclick="deleteConnection('${conn.id}')"><span class="material-symbols-outlined">delete</span> Excluir</button>
                    </div>
                    <div class="mobile-actions">
                        <button class="kebab-menu-btn" onclick="toggleKebabMenu(event)">
                            <span class="material-symbols-outlined">more_vert</span>
                        </button>
                        <div class="kebab-menu-dropdown">
                            ${!isConnected ? `<a href="#" onclick="event.preventDefault(); connectInstance('${conn.id}'); this.closest('.kebab-menu-dropdown').classList.remove('show');">Conectar</a>` : ''}
                            ${isConnected ? `<a href="#" onclick="event.preventDefault(); disconnectInstance('${conn.id}');">Desconectar</a>` : ''}
                            <a href="#" onclick="event.preventDefault(); restartInstance('${conn.id}');">Reiniciar</a>
                            <a href="#" onclick="event.preventDefault(); editConnection('${conn.id}'); this.closest('.kebab-menu-dropdown').classList.remove('show');">Editar</a>
                            <a href="#" onclick="event.preventDefault(); deleteConnection('${conn.id}');">Excluir</a>
                        </div>
                    </div>
                </td>
            `;
            tbody.appendChild(tr);
        });
        setupTableSorting('connectionsTable');
    }

    // --- QR MODAL LOGIC ---

    function showQRModal(qrCode, connection) {
        const modal = document.getElementById('qrModal');
        const container = document.getElementById('qrContainer');
        
        container.innerHTML = `<img src="${qrCode}" alt="QR Code" style="max-width: 100%;">`;
        modal.classList.add('show');
        
        qrCheckInterval = setInterval(async () => {
            try {
                const response = await fetch(`${EVOLUTION_API}/instance/connectionState/${connection.name}`, {
                    headers: { 'apikey': connection.api_key }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    const status = data.instance?.state || data.state;
                    
                    if (status === 'open') {
                        closeQRModal();
                        showAlert('connectionAlert', 'WhatsApp conectado com sucesso!', 'success');
                        await loadConnections();
                    }
                }
            } catch (error) {
                console.error('Erro ao verificar status:', error);
            }
        }, 3000);
    }

    function closeQRModal() {
        const modal = document.getElementById('qrModal');
        modal.classList.remove('show');
        if (qrCheckInterval) {
            clearInterval(qrCheckInterval);
            qrCheckInterval = null;
        }
        currentConnectionInstance = null;
    }

    function closeQRModalOnOverlay(event) {
        if (event.target.id === 'qrModal') {
            closeQRModal();
        }
    }

    // --- LOGS LOGIC ---

    async function loadLogs() {
        try {
            document.getElementById('logsLoading').style.display = 'block';
            document.getElementById('logsTable').style.display = 'none';
            const data = await apiRequest('/logs-list');
            logs = Array.isArray(data) ? data : (data?.logs ?? []);
            renderLogs();
            document.getElementById('logsLoading').style.display = 'none';
            document.getElementById('logsTable').style.display = 'table';
        } catch (error) {
            console.error('Erro ao carregar logs:', error);
            document.getElementById('logsLoading').innerHTML = '<p style="color:#dc3545;">❌ Erro ao carregar logs.</p>';
        }
    }

    function renderLogs() {
        const tbody = document.querySelector('#logsTable tbody');
        tbody.innerHTML = '';
        if (!logs.length) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:20px;">Nenhum log</td></tr>';
            return;
        }
        logs.forEach(l => {
            const statusBadge = l.status?.toUpperCase() === 'ERROR' 
                ? `<span class="badge badge-error">${l.status}</span>` 
                : `<span class="badge badge-success">${l.status || 'N/A'}</span>`;
            const duration = l.duration_ms ? `${(l.duration_ms / 1000).toFixed(2)}s` : '-';
            const startDate = l.started_at ? new Date(l.started_at).toLocaleString('pt-BR') : '-';
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${statusBadge}</td>
                <td>${l.beneficiario || ''}</td>
                <td>${l.prestador || ''}</td>
                <td>${l.tipo_os || ''}</td>
                <td>${l.error_code || 'Nenhum'}</td>
                <td>${duration}</td>
                <td>${startDate}</td>
            `;
            tbody.appendChild(tr);
        });
        setupTableSorting('logsTable');
    }

    // --- INITIALIZATION ---

    window.addEventListener('load', () => {
        loadTheme();

        const startDatePicker = document.getElementById('startDatePicker');
        const endDatePicker = document.getElementById('endDatePicker');

        const today = new Date();
        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        
        startDatePicker.value = firstDayOfMonth.toISOString().split('T')[0];
        endDatePicker.value = today.toISOString().split('T')[0];

        showTab('dashboard');

        startDatePicker.addEventListener('change', loadDashboardData);
        endDatePicker.addEventListener('change', loadDashboardData);
        
        window.addEventListener('click', () => {
            document.querySelectorAll('.kebab-menu-dropdown.show').forEach(menu => {
                menu.classList.remove('show');
            });
        });
    });
    </script>
</body>
</html>
