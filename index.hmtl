                        <table id="logsTable" style="display: none;">
                            <thead><tr><th class="sortable" data-column="status">Status</th><th class="sortable" data-column="beneficiario">Beneficiário</th><th class="sortable" data-column="prestador">Prestador</th><th class="sortable" data-column="tipo_os">Tipo OS</th><th>Erro</th><th class="sortable" data-column="duration_ms">Duração</th><th class="sortable" data-column="started_at">Início</th></tr></thead>
